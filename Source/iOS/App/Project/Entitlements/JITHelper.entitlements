<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PrimeHack for iPad: minimal entitlements for iCubeJITHelper.appex (get-task-allow only,
	     no App Group or iCloud capabilities so sideloaders like SideStore sign it cleanly). -->
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
